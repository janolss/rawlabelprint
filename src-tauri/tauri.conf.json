{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RawLabelPrint",
  "version": "0.5.5",
  "identifier": "se.rawlabelprint.desktop",
  "build": {
    "beforeDevCommand": "npm run docs:getting-started && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run docs:getting-started && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "settings",
        "title": "RawLabelPrint Settings",
        "width": 800,
        "height": 520,
        "minWidth": 700,
        "minHeight": 360,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset: https://asset:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "deb", "nsis", "appimage"],
    "category": "Utility",
    "shortDescription": "Raw label printing from the browser",
    "longDescription": "Tray application that exposes a localhost HTTP API for sending raw label data directly to Zebra printers on the LAN.",
    "resources": {
      "../docs/getting-started.html": "docs/getting-started.html"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Swedish", "English"]
      }
    },
    "linux": {
      "deb": {
        "section": "utils",
        "files": {
          "/etc/udev/rules.d/99-rawlabelprint-zebra.rules": "udev/99-rawlabelprint-zebra.rules"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0MjAzMTkxODhFQjc4M0YKUldRL2VPdUlrVEVnaExja25RQjE2d0FpbGtONUtxdSsvZU5MOHRMODlXVjgwRTl6ZzMrWExnblkK",
      "endpoints": [
        "https://github.com/janolss/rawlabelprint/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
